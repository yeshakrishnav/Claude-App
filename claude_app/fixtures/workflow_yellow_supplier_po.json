[
  {
    "doctype": "Workflow",
    "name": "Yellow Supplier PO Approval",
    "document_type": "Purchase Order",
    "is_active": 1,
    "send_email_alert": 1,
    "workflow_state_field": "workflow_state",
    "states": [
      {
        "state": "Draft",
        "doc_status": "0",
        "allow_edit": "Purchase User",
        "style": "Primary"
      },
      {
        "state": "Pending Approval",
        "doc_status": "0",
        "allow_edit": "Purchase Manager",
        "style": "Warning"
      },
      {
        "state": "Approved",
        "doc_status": "1",
        "allow_edit": "Purchase Manager",
        "style": "Success"
      },
      {
        "state": "Rejected",
        "doc_status": "2",
        "allow_edit": "Purchase User",
        "style": "Danger"
      }
    ],
    "transitions": [
      {
        "action": "Submit for Approval",
        "state": "Draft",
        "next_state": "Pending Approval",
        "allowed": "Purchase User",
        "allow_self_approval": 1
      },
      {
        "action": "Approve",
        "state": "Pending Approval",
        "next_state": "Approved",
        "allowed": "Purchase Manager",
        "allow_self_approval": 0
      },
      {
        "action": "Reject",
        "state": "Pending Approval",
        "next_state": "Rejected",
        "allowed": "Purchase Manager",
        "allow_self_approval": 0
      },
      {
        "action": "Revise",
        "state": "Rejected",
        "next_state": "Draft",
        "allowed": "Purchase User",
        "allow_self_approval": 1
      }
    ]
  }
]
